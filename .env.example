# Configure these in Vercel; never expose the service key in frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SERVER_ENVIRONMENT_ONLY
APP_ORIGINS=https://YOUR_STORE.vercel.app

# Existing mode stays unchanged until joint acceptance.
MS_COMMERCE_MODE=LEGACY
# Public key only. Never use the service key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLIC_KEY
# Product editor is a separate, explicitly delegated backend capability.
MS_FATEK_PRODUCT_WRITES=0
FATEK_PRODUCT_KEY=REPLACE_ONLY_IN_SERVER_ENVIRONMENT
FATEK_STORE_ORIGIN=https://YOUR_STORE_DOMAIN
# Fotos dos produtos no Cloudflare R2 (opcional). Sem estas quatro, as fotos continuam no Supabase Storage.
R2_ACCOUNT_ID=REPLACE_IN_SERVER_ENVIRONMENT_ONLY
R2_ACCESS_KEY_ID=REPLACE_IN_SERVER_ENVIRONMENT_ONLY
R2_SECRET_ACCESS_KEY=REPLACE_IN_SERVER_ENVIRONMENT_ONLY
R2_BUCKET=ms-product-photos
